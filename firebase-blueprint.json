{
  "entities": {
    "LessonResource": {
      "title": "Lesson Resource",
      "description": "Educational materials including videos and books for lessons",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string" },
        "subjectId": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "book"] },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string", "enum": ["youtube", "ncert", "nios", "international"] },
        "generated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lessonId", "type", "title", "url"]
    },
    "AppConfig": {
      "title": "App Configuration",
      "description": "Global settings for the application",
      "type": "object",
      "properties": {
        "youtubeChannelLink": { "type": "string" },
        "videoGeneratorEnabled": { "type": "boolean" }
      }
    },
    "ExamAttempt": {
      "title": "Exam Attempt",
      "description": "Record of a student's competitive exam session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examType": { "type": "string" },
        "topic": { "type": "string" },
        "subtopic": { "type": "string" },
        "difficulty": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeTaken": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/resources": {
      "schema": "LessonResource",
      "description": "Collection of all education resources"
    },
    "/config": {
      "schema": "AppConfig",
      "description": "Global app settings"
    },
    "/exam_attempts": {
      "schema": "ExamAttempt",
      "description": "Student exam performance records"
    }
  }
}
